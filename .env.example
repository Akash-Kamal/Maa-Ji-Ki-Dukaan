# Maa Ji Ki Dukaan - Environment Configuration Example
# Duplicate this file to .env.local and populate with your Supabase credentials.

# Supabase Public API configuration (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-Only Service Role Key (NEVER expose to client-side code / browser)
# Used only in administrative scripts or protected server-only routes
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
